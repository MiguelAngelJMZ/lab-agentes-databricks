  <rect x="690" y="88" width="160" height="68" rx="12" fill="#1B3139"/><text x="770" y="118" text-anchor="middle" font-size="13" font-weight="700" fill="#fff">Agente</text><text x="770" y="137" text-anchor="middle" font-size="10.5" fill="#C9D3D6">LLM + tools + prompt</text>
