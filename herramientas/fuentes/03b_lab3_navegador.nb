  <rect x="10" y="68" width="270" height="48" rx="10" fill="#fff" stroke="#2272B4" stroke-width="2"/><text x="24" y="89" font-size="12" font-weight="700" fill="#1B3139">agent/mcps.py</text><text x="24" y="106" font-size="10.5" fill="#5A6F77">tu MCP del Lab 2 (por URL)</text>
